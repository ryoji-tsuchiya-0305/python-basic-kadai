      "source": [
        "class Human:\n",
        "  def __init__(self, name: str, age: int):\n",
        "    self.name = name\n",
        "    self.age = age\n",
        "\n",
        "  def printinfo(self):\n",
        "    print(f\"名前：{self.name}　年齢：{self.age}\")\n",
        "\n",
        "\n",
        "human_instance = Human(\"Ryoji Tsuchiya\", 49)\n",
        "\n",
        "human_instance.printinfo()\n"
      ],
